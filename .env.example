# pi-web configuration. Copy to .env (chmod 600) and edit.
# `./start.sh` creates one with a random password if the file is missing.

# --- network -------------------------------------------------------------
# Comma separated list. `tailscale` expands to this node's tailnet IPv4.
# Only binds loopback by default; keep it that way and expose it through
# Tailscale / an SSH tunnel / a reverse proxy with TLS.
HOST=127.0.0.1
# Add the tailnet address (requires the `tailscale` CLI):
#HOST=127.0.0.1,tailscale
PORT=8765

# HTTPS (optional). Without it, anything that is not loopback is plaintext.
#PIWEB_TLS_CERT=/etc/pi-web/tls.crt
#PIWEB_TLS_KEY=/etc/pi-web/tls.key
# Set to 1 to silence the "plaintext HTTP on a non-loopback address" warning.
#PIWEB_ALLOW_PLAINTEXT=0

# --- auth ---------------------------------------------------------------
# Required. The server refuses to start without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
WEB_PASS=change-me
# Cookie signing key (generated automatically if empty).
#WEB_SECRET=

# --- paths / runtime ----------------------------------------------------
# Sandbox root for the file browser and the agent cwd. Defaults to $HOME.
#PIWEB_ROOT=/home/you
# Login shell used to spawn `pi` (so PATH / proxy / API keys match your terminal).
# Defaults to $SHELL when it is bash/zsh/sh/ksh, else /bin/bash.
#PIWEB_SHELL=/bin/bash
# pi stores sessions under <agent dir>/sessions; this is pi's own override.
#PI_CODING_AGENT_DIR=/home/you/.pi/agent
# 1 = disable the terminal view (useful when node-pty cannot be built).
#PIWEB_NO_PTY=0
